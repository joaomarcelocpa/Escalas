<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Style Selector="Border.dia">
        <Setter Property="Background" Value="{DynamicResource SuperficieElevadaBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BordaBrush}" />
        <Setter Property="BorderThickness" Value="{DynamicResource EspessuraBorda}" />
        <Setter Property="Margin" Value="0,0,8,0" />
        <Setter Property="CornerRadius" Value="{DynamicResource RaioGrande}" />
        <Setter Property="Padding" Value="12" />
    </Style>
    <Style Selector="Border.dia.fechado">
        <Setter Property="Background" Value="{DynamicResource SuperficieSutilBrush}" />
        <Setter Property="BorderThickness" Value="0" />
    </Style>
    <Style Selector="Border.dia.fechado TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource DiaFechadoBrush}" />
    </Style>

    <!-- Hoje: fundo com a cor de destaque suave e número na cor de destaque -->
    <Style Selector="Border.dia.hoje">
        <Setter Property="Background" Value="{DynamicResource HojeFundoBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource DestaqueBrush}" />
        <Setter Property="BorderThickness" Value="2" />
    </Style>
    <Style Selector="Border.dia.hoje TextBlock.diaNumero">
        <Setter Property="Foreground" Value="{DynamicResource DestaqueBrush}" />
    </Style>

    <Style Selector="TextBlock.diaNumero">
        <Setter Property="FontFamily" Value="{DynamicResource FonteTitulo}" />
        <Setter Property="FontSize" Value="20" />
        <Setter Property="FontWeight" Value="ExtraBold" />
    </Style>

    <Style Selector="TextBlock.diaTitulo">
        <Setter Property="FontSize" Value="15" />
        <Setter Property="FontWeight" Value="Bold" />
    </Style>

    <!-- Feriado: indicador sutil, sem bloco chamativo -->
    <Style Selector="Ellipse.feriadoPonto">
        <Setter Property="Width" Value="7" />
        <Setter Property="Height" Value="7" />
        <Setter Property="Fill" Value="{DynamicResource FeriadoBrush}" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="TextBlock.feriado">
        <Setter Property="Foreground" Value="{DynamicResource TextoSecundarioBrush}" />
        <Setter Property="FontSize" Value="{DynamicResource TamanhoTextoPequeno}" />
    </Style>

    <!-- Setor: vermelho somente quando abaixo do mínimo -->
    <Style Selector="TextBlock.setor">
        <Setter Property="Foreground" Value="{DynamicResource TextoSecundarioBrush}" />
        <Setter Property="FontSize" Value="{DynamicResource TamanhoTextoPequeno}" />
    </Style>
    <Style Selector="TextBlock.setor.abaixo">
        <Setter Property="Foreground" Value="{DynamicResource AlertaMinimoBrush}" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <Style Selector="Border.func">
        <Setter Property="Background" Value="{DynamicResource SuperficieSutilBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BordaBrush}" />
        <Setter Property="BorderThickness" Value="{DynamicResource EspessuraBorda}" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="Padding" Value="8,5" />
        <Setter Property="Margin" Value="0,0,0,4" />
        <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style Selector="Border.func.disponivel">
        <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="Border.func:pointerover">
        <Setter Property="BorderBrush" Value="{DynamicResource DestaqueBrush}" />
    </Style>
    <!-- Cartões do calendário são só leitura: sem cursor de arrastar nem destaque ao passar o mouse -->
    <Style Selector="Border.func.leitura">
        <Setter Property="Cursor" Value="Arrow" />
    </Style>
    <Style Selector="Border.func.leitura:pointerover">
        <Setter Property="BorderBrush" Value="{DynamicResource BordaBrush}" />
    </Style>

    <!-- Cobertura de folga: funcionário de outra filial (filial extra) -->
    <Style Selector="Border.func.cobertura">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="{DynamicResource DestaqueBrush}" />
    </Style>
    <Style Selector="Border.func.leitura.cobertura:pointerover">
        <Setter Property="BorderBrush" Value="{DynamicResource DestaqueBrush}" />
    </Style>
    <!-- Cobertura de folga no topo do dia da escala semanal, logo abaixo do expediente -->
    <Style Selector="Border.coberturaDia">
        <Setter Property="BorderBrush" Value="{DynamicResource BordaBrush}" />
        <Setter Property="BorderThickness" Value="0,0,0,1" />
        <Setter Property="Padding" Value="0,0,0,8" />
        <Setter Property="Margin" Value="0,0,0,8" />
    </Style>

    <Style Selector="Border.disponiveis">
        <Setter Property="BorderBrush" Value="{DynamicResource BordaBrush}" />
        <Setter Property="BorderThickness" Value="0,1,0,0" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Padding" Value="0,8,0,0" />
        <Setter Property="Margin" Value="0,12,0,0" />
    </Style>

    <Style Selector="Button.link">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource TextoSecundarioBrush}" />
        <Setter Property="FontSize" Value="{DynamicResource TamanhoTextoPequeno}" />
        <Setter Property="Padding" Value="4,0" />
    </Style>

    <Style Selector="Button.barra">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="{DynamicResource BordaBrush}" />
        <Setter Property="BorderThickness" Value="{DynamicResource EspessuraBorda}" />
        <Setter Property="CornerRadius" Value="{DynamicResource Raio}" />
        <Setter Property="Padding" Value="10,4" />
    </Style>

    <!-- Funcionário clicável no calendário (abre as horas da semana) -->
    <Style Selector="Border.func.leitura.clicavel">
        <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style Selector="Border.func.leitura.clicavel:pointerover">
        <Setter Property="BorderBrush" Value="{DynamicResource DestaqueBrush}" />
    </Style>

    <!-- Gestão de horários -->
    <Style Selector="Button.expediente">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource TextoSecundarioBrush}" />
        <Setter Property="FontSize" Value="{DynamicResource TamanhoTextoPequeno}" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="HorizontalAlignment" Value="Left" />
    </Style>
    <Style Selector="Button.expediente:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource DestaqueBrush}" />
    </Style>
    <Style Selector="Button.expediente.semExpediente">
        <Setter Property="FontStyle" Value="Italic" />
    </Style>

    <Style Selector="TextBox.hora">
        <Setter Property="CornerRadius" Value="{DynamicResource Raio}" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="MinHeight" Value="32" />
    </Style>

    <Style Selector="TextBlock.semExpediente">
        <Setter Property="FontStyle" Value="Italic" />
    </Style>
    <Style Selector="Grid.horasDia.futuro">
        <Setter Property="Opacity" Value="0.6" />
    </Style>
    <Style Selector="TextBlock.totalHoras">
        <Setter Property="FontFamily" Value="{DynamicResource FonteTitulo}" />
        <Setter Property="FontSize" Value="20" />
        <Setter Property="FontWeight" Value="ExtraBold" />
    </Style>

    <Style Selector="Grid.resumoCabecalho">
        <Setter Property="Margin" Value="12,0,12,4" />
    </Style>
    <Style Selector="Grid.resumoFilial">
        <Setter Property="Margin" Value="0,0,12,4" />
    </Style>
    <Style Selector="Border.resumoLinha">
        <Setter Property="Background" Value="{DynamicResource SuperficieElevadaBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BordaBrush}" />
        <Setter Property="BorderThickness" Value="{DynamicResource EspessuraBorda}" />
        <Setter Property="CornerRadius" Value="{DynamicResource Raio}" />
        <Setter Property="Padding" Value="12,6" />
        <Setter Property="Margin" Value="0,0,0,4" />
    </Style>
    <Style Selector="StackPanel.celula TextBlock.intervalo">
        <Setter Property="FontSize" Value="{DynamicResource TamanhoTextoPequeno}" />
    </Style>
    <Style Selector="StackPanel.celula.folga TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource DiaFechadoBrush}" />
    </Style>
    <Style Selector="StackPanel.celula.semExpediente TextBlock.intervalo">
        <Setter Property="FontStyle" Value="Italic" />
        <Setter Property="Foreground" Value="{DynamicResource TextoSecundarioBrush}" />
    </Style>
</Styles>

<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Escalas.Desktop.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="480" d:DesignHeight="360"
        x:Class="Escalas.Desktop.Views.LoginWindow"
        x:DataType="vm:LoginViewModel"
        Icon="/Assets/avalonia-logo.ico"
        Width="440" Height="460" CanResize="False"
        WindowStartupLocation="CenterScreen"
        Title="Escalas — Entrar">

    <Design.DataContext>
        <vm:LoginViewModel />
    </Design.DataContext>

    <StackPanel VerticalAlignment="Center" Width="320" Spacing="{DynamicResource Espaco4}">
        <StackPanel Spacing="{DynamicResource Espaco1}">
            <Image Source="avares://Escalas.Desktop/Assets/logo.png" Width="220" HorizontalAlignment="Center" Margin="0,0,0,8" RenderOptions.BitmapInterpolationMode="HighQuality" />
            <TextBlock Classes="secundario" Text="Controle de escalas de trabalho" HorizontalAlignment="Center" />
        </StackPanel>

        <!-- Banco ausente / chave ausente / erro: mensagem clara, sem login nem criação de empresa -->
        <Border Classes="painel" IsVisible="{Binding ProblemaVisivel}">
            <TextBlock Text="{Binding Problema}" TextWrapping="Wrap" />
        </Border>

        <StackPanel Spacing="{DynamicResource Espaco2}" IsVisible="{Binding FormularioVisivel}">
            <TextBlock Classes="secundario" Text="Usuário" />
            <TextBox Text="{Binding Login}" />
            <TextBlock Classes="secundario" Text="Senha" />
            <TextBox Text="{Binding Senha}" PasswordChar="•" />
            <TextBlock Text="{Binding Erro}" IsVisible="{Binding ErroVisivel}"
                       Foreground="{DynamicResource AlertaMinimoBrush}" />
            <Button Classes="destaque" Content="Entrar" IsDefault="True"
                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                    Command="{Binding EntrarCommand}" Margin="0,8,0,0" />
        </StackPanel>
    </StackPanel>
</Window>

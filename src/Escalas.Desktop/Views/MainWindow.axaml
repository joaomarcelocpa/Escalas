<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Escalas.Desktop.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1100" d:DesignHeight="700"
        x:Class="Escalas.Desktop.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Icon="/Assets/avalonia-logo.ico"
        Width="1100" Height="700" MinWidth="800" MinHeight="500"
        Title="{Binding Titulo}">

    <Design.DataContext>
        <vm:MainViewModel />
    </Design.DataContext>

    <DockPanel>
        <Border DockPanel.Dock="Top" Padding="{DynamicResource PaddingEspaco4}"
                BorderBrush="{DynamicResource BordaBrush}" BorderThickness="0,0,0,1">
            <StackPanel Spacing="{DynamicResource Espaco1}">
                <TextBlock Classes="titulo" Text="{Binding Titulo}" />
                <TextBlock Classes="secundario" Text="{Binding Subtitulo}" />
            </StackPanel>
        </Border>

        <Border Classes="painel" Margin="{DynamicResource PaddingEspaco4}"
                VerticalAlignment="Top" HorizontalAlignment="Left">
            <StackPanel Spacing="{DynamicResource Espaco2}">
                <TextBlock Text="Fundação concluída." />
                <TextBlock Classes="secundario" Text="Login e calendário semanal entram nas próximas fases." />
            </StackPanel>
        </Border>
    </DockPanel>
</Window>

<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Escalas.Desktop.ViewModels"
             xmlns:ent="using:Escalas.Domain.Entidades"
             x:Class="Escalas.Desktop.Views.SetoresView"
             x:DataType="vm:SetoresViewModel">
    <DockPanel>
        <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto,Auto" Margin="0,0,0,16">
            <TextBlock Classes="titulo" Text="Setores" />
            <ComboBox Grid.Column="1" Classes="filtro" Margin="0,0,8,0"
                      ItemsSource="{Binding Filiais}" SelectedItem="{Binding FilialSelecionada}">
                <ComboBox.ItemTemplate>
                    <DataTemplate x:DataType="ent:Filial">
                        <TextBlock Text="{Binding Nome}" />
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
            <Button Grid.Column="2" Classes="destaque" Content="Novo setor" Command="{Binding NovoCommand}" />
        </Grid>

        <Grid ColumnDefinitions="*,24,280">
            <Border Classes="lista">
                <ListBox Classes="cadastro" ItemsSource="{Binding Itens}" SelectedItem="{Binding Selecionado}">
                    <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="ent:Setor">
                            <TextBlock Text="{Binding Nome}" />
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Border>

            <StackPanel Grid.Column="2" Classes="formulario">
                <TextBlock Classes="rotulo" Text="Nome" Margin="0,0,0,4" />
                <TextBox Text="{Binding Nome}" />
                <StackPanel Classes="acoes">
                    <Button Classes="destaque" Content="Salvar" Command="{Binding SalvarCommand}" />
                    <Button Classes="secundario" Content="Excluir" Command="{Binding ExcluirCommand}" />
                </StackPanel>
                <Border Classes="mensagem" IsVisible="{Binding Erro, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                    <TextBlock Text="{Binding Erro}" TextWrapping="Wrap" />
                </Border>
            </StackPanel>
        </Grid>
    </DockPanel>
</UserControl>

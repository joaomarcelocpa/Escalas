<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctl="using:Escalas.Desktop.Controls"
             xmlns:vm="using:Escalas.Desktop.ViewModels"
             xmlns:app="using:Escalas.Application.Calendario"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="1000" d:DesignHeight="600"
             x:Class="Escalas.Desktop.Views.EscalaSemanalView"
             x:DataType="vm:EscalaSemanalViewModel">

    <Design.DataContext>
        <vm:EscalaSemanalViewModel />
    </Design.DataContext>

    <DockPanel>
        <Grid DockPanel.Dock="Top" ColumnDefinitions="Auto,*,Auto" Margin="0,0,0,4">
            <StackPanel Orientation="Horizontal" Spacing="{DynamicResource Espaco2}">
                <TextBlock Classes="titulo" Text="Escala semanal" VerticalAlignment="Center" />
            </StackPanel>
            <TextBlock Grid.Column="1" Classes="secundario" Text="{Binding Mensagem}"
                       Foreground="{DynamicResource AlertaMinimoBrush}"
                       HorizontalAlignment="Center" VerticalAlignment="Center" />
            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="{DynamicResource Espaco2}">
                <ComboBox ItemsSource="{Binding Filiais}" SelectedItem="{Binding FilialSelecionada}"
                          MinWidth="180" VerticalAlignment="Center">
                    <ComboBox.ItemTemplate>
                        <DataTemplate x:DataType="app:FilialResumo">
                            <TextBlock Text="{Binding Nome}" />
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
                <ComboBox ItemsSource="{Binding Setores}" SelectedItem="{Binding SetorSelecionado}"
                          MinWidth="160" VerticalAlignment="Center">
                    <ComboBox.ItemTemplate>
                        <DataTemplate x:DataType="vm:SetorFiltro">
                            <TextBlock Text="{Binding Nome}" />
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
            </StackPanel>
        </Grid>
        <TextBlock DockPanel.Dock="Top" Classes="secundario" Margin="0,0,0,12"
                   Text="Modelo que se repete em todas as semanas. Ajustes de um dia específico são feitos no Calendário." />

        <TextBlock DockPanel.Dock="Top" Classes="secundario" IsVisible="{Binding SemFiliais}"
                   Text="Nenhuma filial cadastrada. Cadastre uma filial para montar a escala." />

        <ItemsControl ItemsSource="{Binding Dias}">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <UniformGrid Rows="1" />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:DiaPadraoViewModel">
                    <Border Classes="dia" DragDrop.AllowDrop="True">
                        <DockPanel>
                            <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="0,0,0,8">
                                <TextBlock Classes="diaTitulo" Text="{Binding Titulo}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                <TextBlock Grid.Column="1" Classes="setor" Text="{Binding Contagem}" VerticalAlignment="Center" />
                            </Grid>

                            <!-- Disponíveis: origem para alocar e destino para desalocar -->
                            <Border DockPanel.Dock="Bottom" Classes="disponiveis" Tag="disponiveis"
                                    DragDrop.AllowDrop="True">
                                <Expander IsExpanded="False" Padding="0,8,0,0" HorizontalAlignment="Stretch">
                                    <Expander.Header>
                                        <TextBlock Classes="secundario" Text="{Binding TextoDisponiveis}" />
                                    </Expander.Header>
                                    <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="170">
                                        <ItemsControl ItemsSource="{Binding Disponiveis}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="vm:FuncionarioPadraoItem">
                                                    <Border Classes="func disponivel">
                                                        <Grid ColumnDefinitions="Auto,*">
                                                            <ctl:AvatarFuncionario Width="22" Height="22" Margin="0,0,6,0" Foto="{Binding Foto}" Nome="{Binding Nome}" />
                                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                                <TextBlock Text="{Binding Nome}" TextTrimming="CharacterEllipsis" />
                                                                <TextBlock Classes="secundario" Text="{Binding Detalhe}" TextTrimming="CharacterEllipsis" />
                                                            </StackPanel>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>
                                </Expander>
                            </Border>

                            <!-- Alocados no dia (lista única; o setor aparece embaixo do nome) -->
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <ItemsControl ItemsSource="{Binding Escalados}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:FuncionarioPadraoItem">
                                            <Border Classes="func">
                                                <Grid ColumnDefinitions="Auto,*,Auto">
                                                    <ctl:AvatarFuncionario Width="28" Height="28" Margin="0,0,8,0" Foto="{Binding Foto}" Nome="{Binding Nome}" />
                                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding Nome}" TextTrimming="CharacterEllipsis" />
                                                        <TextBlock Classes="secundario" Text="{Binding Detalhe}" TextTrimming="CharacterEllipsis" />
                                                    </StackPanel>
                                                    <Button Grid.Column="2" Classes="link" Content="×" ToolTip.Tip="Remover deste dia"
                                                            VerticalAlignment="Center"
                                                            Command="{Binding $parent[UserControl].((vm:EscalaSemanalViewModel)DataContext).DesalocarCommand}"
                                                            CommandParameter="{Binding}" />
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </DockPanel>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </DockPanel>
</UserControl>

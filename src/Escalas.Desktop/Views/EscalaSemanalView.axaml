<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctl="using:Escalas.Desktop.Controls"
             xmlns:vm="using:Escalas.Desktop.ViewModels"
             xmlns:ent="using:Escalas.Domain.Entidades"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="1000" d:DesignHeight="600"
             x:Class="Escalas.Desktop.Views.EscalaSemanalView"
             x:DataType="vm:EscalaSemanalViewModel">

    <Design.DataContext>
        <vm:EscalaSemanalViewModel />
    </Design.DataContext>

    <DockPanel>
        <Grid DockPanel.Dock="Top" ColumnDefinitions="Auto,*,Auto" Margin="0,0,0,16">
            <StackPanel Orientation="Horizontal" Spacing="{DynamicResource Espaco2}">
                <TextBlock Classes="titulo" Text="Escala semanal" VerticalAlignment="Center" />
            </StackPanel>
            <TextBlock Grid.Column="1" Classes="secundario" Text="{Binding Mensagem}"
                       Foreground="{DynamicResource AlertaMinimoBrush}"
                       HorizontalAlignment="Center" VerticalAlignment="Center" />
            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="{DynamicResource Espaco2}">
                <ComboBox ItemsSource="{Binding Filiais}" SelectedItem="{Binding FilialSelecionada}"
                          MinWidth="180" VerticalAlignment="Center">
                    <ComboBox.ItemTemplate>
                        <DataTemplate x:DataType="ent:FilialOpcao">
                            <TextBlock Text="{Binding Nome}" />
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
                <Border Width="8" />
                <Button Classes="barra" Content="Expediente" VerticalAlignment="Center"
                        ToolTip.Tip="Horário de início e fim de cada dia da semana (todas as filiais)"
                        Command="{Binding EditarExpedienteCommand}" />
                <Button Classes="barra" Content="Exportar planilha" VerticalAlignment="Center"
                        ToolTip.Tip="Planilha .xlsx com a escala de todas as filiais (uma aba por filial)"
                        Click="ExportarPlanilha_Click" />
            </StackPanel>
        </Grid>

        <ItemsControl ItemsSource="{Binding Dias}">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <UniformGrid Rows="1" />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:DiaPadraoViewModel">
                    <Border Classes="dia" DragDrop.AllowDrop="True">
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Top" Spacing="2" Margin="0,0,0,8">
                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBlock Classes="diaTitulo" Text="{Binding Titulo}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Grid.Column="1" Classes="setor" Text="{Binding Contagem}" VerticalAlignment="Center" />
                                </Grid>
                                <Button Classes="expediente" Classes.semExpediente="{Binding SemExpediente}"
                                        ToolTip.Tip="Editar expediente"
                                        Command="{Binding $parent[UserControl].((vm:EscalaSemanalViewModel)DataContext).EditarExpedienteCommand}">
                                    <TextBlock Text="{Binding TextoExpediente}" TextTrimming="CharacterEllipsis" />
                                </Button>
                            </StackPanel>

                            <!-- Cobertura de folga: quem vem de outra filial (filial extra), quem pode vir e quem saiu daqui para cobrir -->
                            <Border DockPanel.Dock="Top" Classes="coberturaDia" IsVisible="{Binding MostrarCobertura}">
                                <StackPanel Spacing="4">
                                    <TextBlock Classes="secundario" Text="Cobertura de folga" />
                                    <ItemsControl ItemsSource="{Binding Cobrindo}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="vm:CoberturaPadraoItem">
                                                <Border Classes="func leitura cobertura">
                                                    <Grid ColumnDefinitions="Auto,*,Auto">
                                                        <ctl:AvatarFuncionario Width="28" Height="28" Margin="0,0,8,0" Foto="{Binding Foto}" Nome="{Binding Nome}" />
                                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding Nome}" TextTrimming="CharacterEllipsis" />
                                                            <TextBlock Classes="secundario" Text="{Binding Detalhe}" TextTrimming="CharacterEllipsis" />
                                                        </StackPanel>
                                                        <Button Grid.Column="2" Classes="link" Content="×" VerticalAlignment="Center"
                                                                ToolTip.Tip="Desfazer cobertura (volta para a filial dele neste dia)"
                                                                Command="{Binding $parent[UserControl].((vm:EscalaSemanalViewModel)DataContext).RemoverCoberturaCommand}"
                                                                CommandParameter="{Binding}" />
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <ComboBox HorizontalAlignment="Stretch" PlaceholderText="Cobrir folga com…"
                                              IsVisible="{Binding TemCandidatos}"
                                              ToolTip.Tip="Quem tem esta filial como extra e trabalha neste dia na filial dele. Ele sai de lá neste dia."
                                              ItemsSource="{Binding Candidatos}" SelectedItem="{Binding CandidatoEscolhido}">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate x:DataType="vm:CoberturaPadraoItem">
                                                <StackPanel>
                                                    <TextBlock Text="{Binding Nome}" TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Classes="secundario" Text="{Binding Detalhe}" TextTrimming="CharacterEllipsis" />
                                                </StackPanel>
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                    <ItemsControl ItemsSource="{Binding Fora}" IsVisible="{Binding TemFora}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="vm:CoberturaPadraoItem">
                                                <TextBlock Classes="secundario" TextTrimming="CharacterEllipsis"
                                                           ToolTip.Tip="Neste dia trabalha na outra filial (desfaça a cobertura por lá)">
                                                    <Run Text="{Binding Nome}" />
                                                    <Run Text="·" />
                                                    <Run Text="{Binding Detalhe}" />
                                                </TextBlock>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>

                            <!-- Disponíveis: origem para alocar e destino para desalocar -->
                            <Border DockPanel.Dock="Bottom" Classes="disponiveis" Tag="disponiveis"
                                    DragDrop.AllowDrop="True">
                                <Expander IsExpanded="False" Padding="0,8,0,0" HorizontalAlignment="Stretch">
                                    <Expander.Header>
                                        <TextBlock Classes="secundario" Text="{Binding TextoDisponiveis}" />
                                    </Expander.Header>
                                    <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="170">
                                        <ItemsControl ItemsSource="{Binding Disponiveis}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="vm:FuncionarioPadraoItem">
                                                    <Border Classes="func disponivel">
                                                        <Grid ColumnDefinitions="Auto,*">
                                                            <ctl:AvatarFuncionario Width="22" Height="22" Margin="0,0,6,0" Foto="{Binding Foto}" Nome="{Binding Nome}" />
                                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                                <TextBlock Text="{Binding Nome}" TextTrimming="CharacterEllipsis" />
                                                                <TextBlock Classes="secundario" Text="{Binding Detalhe}" TextTrimming="CharacterEllipsis" />
                                                            </StackPanel>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>
                                </Expander>
                            </Border>

                            <!-- Alocados no dia (lista única; o setor aparece embaixo do nome) -->
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <ItemsControl ItemsSource="{Binding Escalados}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:FuncionarioPadraoItem">
                                            <Border Classes="func">
                                                <Grid ColumnDefinitions="Auto,*,Auto">
                                                    <ctl:AvatarFuncionario Width="28" Height="28" Margin="0,0,8,0" Foto="{Binding Foto}" Nome="{Binding Nome}" />
                                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding Nome}" TextTrimming="CharacterEllipsis" />
                                                        <TextBlock Classes="secundario" Text="{Binding Detalhe}" TextTrimming="CharacterEllipsis" />
                                                    </StackPanel>
                                                    <Button Grid.Column="2" Classes="link" Content="×" ToolTip.Tip="Remover deste dia"
                                                            VerticalAlignment="Center"
                                                            Command="{Binding $parent[UserControl].((vm:EscalaSemanalViewModel)DataContext).DesalocarCommand}"
                                                            CommandParameter="{Binding}" />
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </DockPanel>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </DockPanel>
</UserControl>

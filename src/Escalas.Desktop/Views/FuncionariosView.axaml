<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Escalas.Desktop.ViewModels"
             xmlns:ctl="using:Escalas.Desktop.Controls"
             xmlns:ent="using:Escalas.Domain.Entidades"
             x:Class="Escalas.Desktop.Views.FuncionariosView"
             x:DataType="vm:FuncionariosViewModel">
    <DockPanel>
        <TextBlock DockPanel.Dock="Top" Classes="titulo" Text="Funcionários" Margin="0,0,0,16" />

        <Grid ColumnDefinitions="*,24,340">
            <ListBox Classes="cartoes" ItemsSource="{Binding Itens}" SelectedItem="{Binding Selecionado}">
                <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="ent:Funcionario">
                        <StackPanel Spacing="6">
                            <ctl:AvatarFuncionario Width="48" Height="48" HorizontalAlignment="Center" Foto="{Binding Foto}" Nome="{Binding Nome}" />
                            <TextBlock Classes="cartaoNome" Text="{Binding Nome}" />
                            <TextBlock Classes="secundario" Text="{Binding Setor.Nome}" />
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <ScrollViewer Grid.Column="2" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
            <StackPanel Classes="formulario" Margin="0,0,12,0">
                <StackPanel Orientation="Horizontal" Spacing="12" Margin="0,0,0,12">
                    <ctl:AvatarFuncionario Width="56" Height="56" Foto="{Binding Foto}" Nome="{Binding Nome}" />
                    <StackPanel VerticalAlignment="Center" Spacing="4">
                        <Button Classes="secundario" Content="Escolher foto…" Click="EscolherFoto_Click" />
                        <Button Classes="secundario" Content="Remover foto" Command="{Binding RemoverFotoCommand}" />
                    </StackPanel>
                </StackPanel>
                <TextBlock Classes="rotulo" Text="Nome" Margin="0,0,0,4" />
                <TextBox Text="{Binding Nome}" />
                <TextBlock Classes="rotulo" Text="Filial" />
                <ComboBox ItemsSource="{Binding Filiais}" SelectedItem="{Binding FilialSelecionada}">
                    <ComboBox.ItemTemplate>
                        <DataTemplate x:DataType="ent:FilialOpcao">
                            <TextBlock Text="{Binding Nome}" />
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
                <TextBlock Classes="rotulo" Text="Setor" />
                <ComboBox ItemsSource="{Binding Setores}" SelectedItem="{Binding SetorSelecionado}">
                    <ComboBox.ItemTemplate>
                        <DataTemplate x:DataType="ent:Setor">
                            <TextBlock Text="{Binding Nome}" />
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
                <TextBlock Classes="rotulo" Text="Filial extra (opcional)" />
                <ComboBox ItemsSource="{Binding FiliaisExtra}" SelectedItem="{Binding FilialExtraSelecionada}">
                    <ComboBox.ItemTemplate>
                        <DataTemplate x:DataType="vm:FilialExtraOpcao">
                            <TextBlock Text="{Binding Nome}" />
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
                <TextBlock Classes="secundario" TextWrapping="Wrap" Margin="0,4,0,0"
                           Text="Pode cobrir a folga dos funcionários fixos dessa filial. A cobertura é escolhida na Escala semanal." />
                <CheckBox Margin="0,12,0,0" Content="Horário de trabalho personalizado" IsChecked="{Binding HorarioPersonalizado}" />
                <StackPanel IsVisible="{Binding HorarioPersonalizado}" Spacing="6" Margin="0,4,0,0">
                    <TextBlock Classes="secundario" TextWrapping="Wrap"
                               Text="Horário próprio deste funcionário em cada dia. Dia vazio segue o expediente geral. As folgas continuam na Escala semanal." />
                    <ItemsControl ItemsSource="{Binding HorariosDias}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:ExpedienteDiaItem">
                                <Grid ColumnDefinitions="64,*,24,*,Auto" RowDefinitions="Auto,Auto" Margin="0,0,0,6">
                                    <TextBlock Grid.Column="0" Text="{Binding Titulo}" VerticalAlignment="Center" />
                                    <TextBox Grid.Column="1" Classes="hora" Text="{Binding Inicio}" PlaceholderText="{Binding PlaceholderInicio}" />
                                    <TextBlock Grid.Column="2" Classes="secundario" Text="às" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    <TextBox Grid.Column="3" Classes="hora" Text="{Binding Fim}" PlaceholderText="{Binding PlaceholderFim}" />
                                    <Button Grid.Column="4" Classes="link" Content="×" ToolTip.Tip="Usar o expediente geral neste dia"
                                            VerticalAlignment="Center"
                                            Command="{Binding $parent[UserControl].((vm:FuncionariosViewModel)DataContext).LimparHorarioDiaCommand}"
                                            CommandParameter="{Binding}" />
                                    <TextBlock Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="4" Classes="secundario"
                                               Text="{Binding Duracao}" Margin="0,2,0,0" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Button Classes="link" Content="Repetir o primeiro horário nos outros dias" Command="{Binding RepetirPrimeiroHorarioCommand}" />
                </StackPanel>
                <CheckBox Margin="0,12,0,0" Content="Ativo" IsChecked="{Binding Ativo}" />
                <StackPanel Classes="acoes">
                    <Button Classes="destaque" Content="Salvar" Command="{Binding SalvarCommand}" />
                    <Button Classes="secundario" Content="Excluir" Command="{Binding ExcluirCommand}" />
                </StackPanel>
                <Border Classes="mensagem" IsVisible="{Binding Erro, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                    <TextBlock Text="{Binding Erro}" TextWrapping="Wrap" />
                </Border>
            </StackPanel>
            </ScrollViewer>
        </Grid>
    </DockPanel>
</UserControl>

<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Escalas.Desktop.ViewModels"
             xmlns:ctl="using:Escalas.Desktop.Controls"
             xmlns:ent="using:Escalas.Domain.Entidades"
             x:Class="Escalas.Desktop.Views.FuncionariosView"
             x:DataType="vm:FuncionariosViewModel">
    <DockPanel>
        <TextBlock DockPanel.Dock="Top" Classes="titulo" Text="Funcionários" Margin="0,0,0,16" />

        <Grid ColumnDefinitions="*,24,280">
            <ListBox Classes="cartoes" ItemsSource="{Binding Itens}" SelectedItem="{Binding Selecionado}">
                <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="ent:Funcionario">
                        <StackPanel Spacing="6">
                            <ctl:AvatarFuncionario Width="48" Height="48" HorizontalAlignment="Center" Foto="{Binding Foto}" Nome="{Binding Nome}" />
                            <TextBlock Classes="cartaoNome" Text="{Binding Nome}" />
                            <TextBlock Classes="secundario" Text="{Binding Setor.Nome}" />
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <StackPanel Grid.Column="2" Classes="formulario">
                <StackPanel Orientation="Horizontal" Spacing="12" Margin="0,0,0,12">
                    <ctl:AvatarFuncionario Width="56" Height="56" Foto="{Binding Foto}" Nome="{Binding Nome}" />
                    <StackPanel VerticalAlignment="Center" Spacing="4">
                        <Button Classes="secundario" Content="Escolher foto…" Click="EscolherFoto_Click" />
                        <Button Classes="secundario" Content="Remover foto" Command="{Binding RemoverFotoCommand}" />
                    </StackPanel>
                </StackPanel>
                <TextBlock Classes="rotulo" Text="Nome" Margin="0,0,0,4" />
                <TextBox Text="{Binding Nome}" />
                <TextBlock Classes="rotulo" Text="Filial" />
                <ComboBox ItemsSource="{Binding Filiais}" SelectedItem="{Binding FilialSelecionada}">
                    <ComboBox.ItemTemplate>
                        <DataTemplate x:DataType="ent:Filial">
                            <TextBlock Text="{Binding Nome}" />
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
                <TextBlock Classes="rotulo" Text="Setor" />
                <ComboBox ItemsSource="{Binding Setores}" SelectedItem="{Binding SetorSelecionado}">
                    <ComboBox.ItemTemplate>
                        <DataTemplate x:DataType="ent:Setor">
                            <TextBlock Text="{Binding Nome}" />
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
                <CheckBox Margin="0,12,0,0" Content="Ativo" IsChecked="{Binding Ativo}" />
                <StackPanel Classes="acoes">
                    <Button Classes="destaque" Content="Salvar" Command="{Binding SalvarCommand}" />
                    <Button Classes="secundario" Content="Excluir" Command="{Binding ExcluirCommand}" />
                </StackPanel>
                <Border Classes="mensagem" IsVisible="{Binding Erro, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                    <TextBlock Text="{Binding Erro}" TextWrapping="Wrap" />
                </Border>
            </StackPanel>
        </Grid>
    </DockPanel>
</UserControl>

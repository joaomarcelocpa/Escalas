<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctl="using:Escalas.Desktop.Controls"
             xmlns:vm="using:Escalas.Desktop.ViewModels"
             xmlns:ent="using:Escalas.Domain.Entidades"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="1000" d:DesignHeight="600"
             x:Class="Escalas.Desktop.Views.CalendarioView"
             x:DataType="vm:CalendarioViewModel">

    <Design.DataContext>
        <vm:CalendarioViewModel />
    </Design.DataContext>

    <DockPanel>
        <!-- Barra superior: filial e navegação de semana -->
        <Grid DockPanel.Dock="Top" ColumnDefinitions="Auto,*,Auto" Margin="0,0,0,8">
            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="{DynamicResource Espaco2}">
                <TextBlock Classes="titulo" Text="Calendário" VerticalAlignment="Center" />
            </StackPanel>
            <TextBlock Grid.Column="1" Classes="secundario" Text="{Binding Mensagem}"
                       Foreground="{DynamicResource AlertaMinimoBrush}"
                       HorizontalAlignment="Center" VerticalAlignment="Center" />
            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="{DynamicResource Espaco2}">
                <ComboBox ItemsSource="{Binding Filiais}" SelectedItem="{Binding FilialSelecionada}"
                          MinWidth="180" VerticalAlignment="Center">
                    <ComboBox.ItemTemplate>
                        <DataTemplate x:DataType="ent:FilialOpcao">
                            <TextBlock Text="{Binding Nome}" />
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
                <Border Width="8" />
                <Button Classes="barra" Content="‹" Command="{Binding SemanaAnteriorCommand}" />
                <Button Classes="barra" Content="Hoje" Command="{Binding IrParaHojeCommand}" />
                <TextBlock Text="{Binding TituloSemana}" VerticalAlignment="Center" Margin="8,0" />
                <Button Classes="barra" Content="›" Command="{Binding ProximaSemanaCommand}" />
            </StackPanel>
        </Grid>

        <!-- Gestão de horários (só visualização): horas por funcionário e resumo da semana visível -->
        <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="0,0,0,12">
            <TextBlock Classes="secundario" VerticalAlignment="Center"
                       Text="Clique em um funcionário para ver os dias e as horas dele na semana." />
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="{DynamicResource Espaco2}">
                <Button Classes="barra" Content="Resumo semanal" ToolTip.Tip="Dias e horas de todos os funcionários, por filial"
                        Command="{Binding ResumoSemanalCommand}" />
            </StackPanel>
        </Grid>

        <ItemsControl ItemsSource="{Binding Dias}">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <UniformGrid Rows="1" />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:DiaViewModel">
                    <Border Classes="dia" Classes.fechado="{Binding Fechado}" Classes.hoje="{Binding Hoje}">
                        <DockPanel>
                            <!-- Cabeçalho do dia -->
                            <StackPanel DockPanel.Dock="Top" Spacing="2" Margin="0,0,0,8">
                                <Grid ColumnDefinitions="Auto,*,Auto">
                                    <TextBlock Grid.Column="0" Classes="diaNumero" Text="{Binding Numero}" />
                                    <TextBlock Grid.Column="1" Classes="secundario" Text="{Binding DiaSemana}"
                                               Margin="6,0,0,0" VerticalAlignment="Center" />
                                    <Button Grid.Column="2" Classes="link" Content="{Binding TextoFechar}"
                                            Command="{Binding $parent[UserControl].((vm:CalendarioViewModel)DataContext).AlternarDiaCommand}"
                                            CommandParameter="{Binding}" />
                                </Grid>
                                <Grid Margin="0,6,0,0" ColumnDefinitions="Auto,*" IsVisible="{Binding TemFeriado}">
                                    <Ellipse Classes="feriadoPonto" VerticalAlignment="Top" Margin="0,5,4,0" />
                                    <TextBlock Grid.Column="1" Classes="feriado" Text="{Binding NomeFeriado}" TextWrapping="Wrap" />
                                </Grid>
                                <TextBlock Classes="secundario" Text="Fechado" Margin="0,6,0,0" IsVisible="{Binding Fechado}" />
                                <TextBlock Classes="secundario" Classes.semExpediente="{Binding SemExpediente}" Margin="0,4,0,0"
                                           Text="{Binding TextoExpediente}" IsVisible="{Binding MostrarExpediente}"
                                           ToolTip.Tip="Expediente definido na Escala semanal" />
                            </StackPanel>

                            <!-- Folga: quem não está escalado no dia. Recolhida por padrão; somente visualização -->
                            <Border DockPanel.Dock="Bottom" Classes="disponiveis">
                                <Expander IsExpanded="False" Padding="0" HorizontalAlignment="Stretch">
                                    <Expander.Header>
                                        <TextBlock Classes="secundario" Text="{Binding TextoDisponiveis}" />
                                    </Expander.Header>
                                    <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="150">
                                        <ItemsControl ItemsSource="{Binding Disponiveis}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="vm:FuncionarioItem">
                                                    <Border Classes="func disponivel leitura clicavel" Tapped="Funcionario_Tapped"
                                                            ToolTip.Tip="Ver horas na semana">
                                                        <Grid ColumnDefinitions="Auto,*">
                                                            <ctl:AvatarFuncionario Width="22" Height="22" Margin="0,0,6,0" Foto="{Binding Foto}" Nome="{Binding Nome}" />
                                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                                <TextBlock Text="{Binding Nome}" TextTrimming="CharacterEllipsis" />
                                                                <TextBlock Classes="secundario" Text="{Binding Detalhe}" TextTrimming="CharacterEllipsis" />
                                                            </StackPanel>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>
                                </Expander>
                            </Border>

                            <!-- Em outra filial: fixos daqui cobrindo folga em outra filial (não estão de folga) -->
                            <Border DockPanel.Dock="Bottom" Classes="disponiveis" IsVisible="{Binding TemFora}">
                                <StackPanel Spacing="4">
                                    <TextBlock Classes="secundario" Text="{Binding TextoFora}" />
                                    <ItemsControl ItemsSource="{Binding Fora}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="vm:FuncionarioItem">
                                                <Border Classes="func disponivel leitura clicavel" Tapped="Funcionario_Tapped"
                                                        ToolTip.Tip="Ver horas na semana">
                                                    <Grid ColumnDefinitions="Auto,*">
                                                        <ctl:AvatarFuncionario Width="22" Height="22" Margin="0,0,6,0" Foto="{Binding Foto}" Nome="{Binding Nome}" />
                                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding Nome}" TextTrimming="CharacterEllipsis" />
                                                            <TextBlock Classes="secundario" Text="{Binding Detalhe}" TextTrimming="CharacterEllipsis" />
                                                        </StackPanel>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>

                            <!-- Escalados no dia (lista única, somente leitura; o setor aparece embaixo do nome) -->
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <ItemsControl ItemsSource="{Binding Escalados}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:FuncionarioItem">
                                            <Border Classes="func leitura clicavel" Classes.cobertura="{Binding Cobertura}"
                                                    Tapped="Funcionario_Tapped" ToolTip.Tip="Ver horas na semana">
                                                <Grid ColumnDefinitions="Auto,*">
                                                    <ctl:AvatarFuncionario Width="28" Height="28" Margin="0,0,8,0" Foto="{Binding Foto}" Nome="{Binding Nome}" />
                                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding Nome}" TextTrimming="CharacterEllipsis" />
                                                        <TextBlock Classes="secundario" Text="{Binding Detalhe}" TextTrimming="CharacterEllipsis" />
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </DockPanel>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </DockPanel>
</UserControl>

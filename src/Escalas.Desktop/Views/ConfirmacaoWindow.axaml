<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Escalas.Desktop.Views.ConfirmacaoWindow"
        Width="400" SizeToContent="Height" CanResize="False"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <StackPanel Margin="{DynamicResource PaddingEspaco6}" Spacing="{DynamicResource Espaco4}">
        <TextBlock x:Name="Titulo" Classes="titulo" />
        <TextBlock x:Name="Mensagem" TextWrapping="Wrap" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="{DynamicResource Espaco2}">
            <Button x:Name="Cancelar" Classes="secundario" Content="Cancelar" IsCancel="True" />
            <Button x:Name="Confirmar" Classes="destaque" IsDefault="True" />
        </StackPanel>
    </StackPanel>
</Window>
